# Required server runtime variables
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
RESEND_API_KEY=re_replace_me
RESEND_EMAIL_FROM="Blackroad <noreply@example.com>"
BASE_URL=https://example.com

# Required client variable (safe to expose in the browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Required only when running `prisma db seed`
SEED_USER_PASSWORD=replace-with-a-seed-only-password
